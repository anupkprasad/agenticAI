; Energy Minimization
define          = -DPOSRES
integrator      = steep
emtol           = 100.0
emstep          = 0.01
nsteps          = 600000

; Output control
nstxout                  = 0
nstxout-compressed       = 0
nstvout                  = 0
nstfout                  = 0
nstenergy                = 1000
nstlog                   = 1000

; Neighbor searching
nstlist         = 1
ns_type         = grid
pbc             = xyz

; Bond parameters
constraints     = h-bonds

; Neighbor searching
cutoff-scheme   = Verlet

; Electrostatics
coulombtype     = PME
rlist           = 1.2
vdwtype         = cutoff
vdw-modifier    = force-switch
rvdw            = 1.2
rcoulomb        = 1.2
rvdw-switch     = 1.0

; Dispersion correction
DispCorr        = EnerPres
