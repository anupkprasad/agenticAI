   # Body for calculate_center_of_mass
   import MDAnalysis as mda
   import numpy as np
   import pandas as pd
   import os
   from pathlib import Path
   from src.analysis.summary_logger import append_analysis_summary
   
   # Resolve input file paths
   topo_path = _resolve_input_path(topology, "topology")
   traj_path = _resolve_input_path(trajectory, "trajectory")
   
   # Load the universe
   u = mda.Universe(str(topo_path), str(traj_path))
   
   # Select atoms
   atoms = u.select_atoms(selection)
   
   # Prepare containers
   times = []
   coms = []
   
   # Iterate over trajectory
   for ts in u.trajectory:
       times.append(ts.time)               # time in ps (MDAnalysis default)
       coms.append(atoms.center_of_mass())
   
   coms = np.array(coms)
   
   # Create dataframe
   df = pd.DataFrame({
       "time": times,
       "com_x": coms[:, 0],
       "com_y": coms[:, 1],
       "com_z": coms[:, 2]
   })
   
   # Resolve output file path
   output_path = Path(output_file).resolve()
   df.to_csv(str(output_path), index=False)
   
   # Logging analysis summary
   working_dir = os.getcwd()
   try:
       stats = {
           "n_frames": len(times),
           "mean_com": np.mean(coms, axis=0).tolist(),
           "std_com": np.std(coms, axis=0).tolist(),
           "min_com": np.min(coms, axis=0).tolist(),
           "max_com": np.max(coms, axis=0).tolist()
       }
       append_analysis_summary(
           working_dir=working_dir,
           analysis_type="CenterOfMass",
           statistics=stats,
           files={
               "topology": str(topo_path),
               "trajectory": str(traj_path),
               "output": str(output_path.name)
           },
           metadata={
               "selection": selection
           }
       )
   except Exception as e:
       # If logging fails, we don't want to break the main function
       import logging
       logging.getLogger(__name__).warning(f"Failed to write analysis summary: {e}")
   
   return {"output_file": str(output_path)}
   ```
   
