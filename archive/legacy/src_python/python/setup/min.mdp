define          = -DPOSRES -DPOSRES_LIG  ; position and ligand restrain the protein
integrator  = steep    ; Algorithm (steep = steepest descent minimization)
                       ; Other available algorithms:
                       ; cg     - conjugate gradient (bad when potential large, good convergence)
                       ; l-bfgs - most expensive, definately gives absolute minima. Use only for NMA
emtol       = 100.0    ; Stop minimization when the maxforce < 100.0 kJ/mol/nm ; convergence criterion (kJ/mol/nm)
emstep      = 0.01     ; Energy step size
nsteps      = 600000   ; Maximum number of (minimization) steps to perform


; Output control
nstxout                  = 0     ; don't write positions to .trr
nstxout-compressed       = 0     ; don't write .xtc
nstvout                  = 0     ; don't write velocities
nstfout                  = 0     ; don't write forces
nstenergy                = 1000   ; OK to write energy occasionally
nstlog                   = 1000   ; minimal log output



; Parameters describing how to find the neighbors of each atom and how to calculate the interactions
nstlist       = 1      ; Frequency to update the neighbor list
ns_type       = grid   ; Method to determine neighbor list (simple, grid)
pbc           = xyz    ; Periodic Boundary Conditions (yes/no)


; Bond parameters
constraints   = h-bonds        ; CHARMM36: Convert the bonds with H-atoms to constraints

; Neighbor searching
cutoff-scheme = Verlet         ; CHARMM36

; Electrostatics
coulombtype   = PME            ; CHARMM36: For long range electrostatics
rlist         = 1.2            ; CHARMM36
vdwtype       = cutoff         ; CHARMM36: twin range cutoffs with neightbor list
vdw-modifier  = force-switch   ; CHARMM36: switches the forces to zero between rvdw-switch and rvdw
rvdw          = 1.2            ; CHARMM36
rcoulomb      = 1.2            ; CHARMM36
rvdw-switch   = 1.0            ; CHARMM36

; Dispersion correction
DispCorr      = no             ; CHARMM36: should be apply in lipid monolayers, not bilayers