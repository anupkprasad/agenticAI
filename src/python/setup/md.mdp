title           = production run
; Run parameters
integrator      = md        ; leap-frog integrator
nsteps          = 100000000 ; 250000000 = 500 ns
dt              = 0.002     ; unit in gromacs is ps so it is 2 fs
comm-mode       = Linear    ;

; Output control
nstxout         = 0         ; do not write .trr positions, since 1000 ps == 1ns so, (50000 steps which is 1 frame) * 10 frames = 1 ns 
nstvout         = 0         ; do not write velocities to .trr
nstfout         = 0         ; do not write forces to .trr
nstenergy       = 50000     ; write energy to .edr every 50000 steps
nstlog          = 50000     ; 
nstxout-compressed = 50000   ; write .xtc every 50000 steps (50000 steps which is 1 frame) * 10 frames = 1 ns 


; Bond parameters
;continuation         = yes       ; first dynamics run
constraint_algorithm = lincs     ; holonomic constraints 
constraints          = h-bonds   ; CHARMM36: Convert the bonds with H-atoms to constraints
lincs_iter           = 1         ; accuracy of LINCS
lincs_order          = 6         ; 6 is needed for large time steps with virtual sites or BD

; Neighbor searching
cutoff-scheme   = Verlet    ; CHARMM36
ns_type         = grid      ; search neighboring grid cels
nstlist         = 20        ; 20*2fs = 40 fs

; Electrostatics
coulombtype     = PME            ; CHARMM36: For long range electrostatics
ewald-rtol      = 1e-5           ; 
pme_order       = 4              ; cubic interpolation
fourierspacing  = 0.12           ; grid spacing for FFT
optimize-fft    = yes            ; 
rlist           = 1.2            ; CHARMM36: short-range neighbor list cutoff (in nm)
rcoulomb        = 1.2            ; CHARMM36: short-range electrostatic cutoff (in nm)
vdwtype         = cutoff         ; CHARMM36: twin range cutoffs with neightbor list
vdw-modifier    = force-switch   ; CHARMM36: smoothly switches the forces to zero between rvdw-switch and rvdw
rvdw            = 1.2            ; CHARMM36: short-range van der Waals cutoff (in nm)
rvdw-switch     = 1.0            ; CHARMM36: where to start switching the LJ force and potential, only if force-switching

; Temperature coupling is on
tcoupl          = V-rescale           ; modified Berendsen thermostat
tc-grps         = Protein Non-Protein ; two coupling groups - more accurate
tau_t           = 0.1  0.1            ; time constant, in ps
ref_t           = 310  310            ; reference temperature, one for each group, in K

; Periodic boundary conditions
pbc             = xyz       ; 3-D PBC

; Dispersion correction
DispCorr        = no        ; CHARMM36: should be apply in lipid monolayers, not bilayers

; Pressure coupling is on
pcoupl          = Berendsen ; pressure coupling on in NPT
pcoupltype      = isotropic ; uniform scaling of box vectors
tau_p           = 2.0       ; time constant, in ps
ref_p           = 1.0       ; reference pressure, in bar
compressibility = 4.5e-5    ; isothermal compressibility of water, bar^-1
refcoord-scaling= all       ;

gen_vel         = yes        ; assign velocities from Maxwell distribution
gen_temp = 310.0
gen_seed = 12345       ; change for each replica